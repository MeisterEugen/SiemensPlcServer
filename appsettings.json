{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://0.0.0.0:5000" } } },
  "AllowedHosts": "*",

  "Plc": {
    "IpAddress": "192.168.1.215",
    "Username": "admin",
    "Password": "",                       
    "AcceptInvalidCertificate": true,     
    "RequestTimeoutSeconds": 10,
    "KeepAliveSeconds": 30,               
    "MaxTagsPerBulk": 200,
    "MaxExpandTags": 400,                 
    "WriteAllow": [
      "\"NonRetain_DB\".\"cmd\".",
      "\"Settings_DB\".\"meas\".",
      "\"Settings_DB\".\"telemetry\"."
    ],
    "WriteApiKey": "",                    
    "Groups": [
      {
        "Name": "state", "PeriodMs": 500,
        "Tags": [
          "NonRetain_DB.state.sys_state",
          "NonRetain_DB.state.meas_mode_active",
          "NonRetain_DB.state.service_mode",
          "NonRetain_DB.state.metal_in_stand",
          "NonRetain_DB.state.meas_armed",
          "NonRetain_DB.state.beam_wanted",
          "NonRetain_DB.state.stand_step",
          "NonRetain_DB.state.stand_done",
          "NonRetain_DB.state.stand_overdue",
          "NonRetain_DB.state.single_meas_done",
          "NonRetain_DB.state.meas_rdy",
          "NonRetain_DB.state.hv_on[1..3]",
          "NonRetain_DB.state.gate_closed[1..3]",
          "NonRetain_DB.state.system_summary.*"
        ]
      },
      {
        "Name": "events", "PeriodMs": 250,
        "Tags": [ "NonRetain_DB.events.*" ]
      },
      {
        "Name": "ready", "PeriodMs": 1000,
        "Tags": [ "NonRetain_DB.state.channel_ready[1..3].*" ]
      },
      {
        "Name": "meas", "PeriodMs": 500, "Enabled": false,
        "Tags": [
          "NonRetain_DB.meas.channels[1..3].t",
          "NonRetain_DB.meas.channels[1..3].t_avg",
          "NonRetain_DB.meas.channels[1..3].temp",
          "NonRetain_DB.meas.channels[1..3].valid",
          "NonRetain_DB.meas.channels[1..3].i_filt",
          "NonRetain_DB.meas.profile.*",
          "NonRetain_DB.meas.thickness_ok",
          "NonRetain_DB.meas.strip_ok",
          "NonRetain_DB.meas.strip_length_m"
        ]
      },
      {
        "Name": "errors", "PeriodMs": 2000,
        "Tags": [ "NonRetain_DB.errors.*" ]
      },
      {
        "Name": "gen", "PeriodMs": 1000,
        "Tags": [
          "Gen_Data_DB.ch[1..3].voltage_cv",
          "Gen_Data_DB.ch[1..3].current_cv",
          "Gen_Data_DB.ch[1..3].comm_ok",
          "Gen_Data_DB.ch[1..3].gen_control_unit_temp",
          "Gen_Data_DB.ch[1..3].gen_status.*",
          "Gen_Data_DB.ch[1..3].gen_errors.*"
        ]
      },
      {
        "Name": "det", "PeriodMs": 1000,
        "Tags": [
          "Det_Data_DB.ch[1..3].comm_ok",
          "Det_Data_DB.ch[1..3].new_data",
          "Det_Data_DB.ch[1..3].packet_count",
          "Det_Data_DB.ch[1..3].udp_rx_count",
          "Det_Data_DB.ch[1..3].bad_frames",
          "Det_Data_DB.ch[1..3].diag",
          "Det_Data_DB.ch[1..3].rcv_status"
        ]
      },
      {
        "Name": "cooling", "PeriodMs": 2000,
        "Tags": [ "NonRetain_DB.cooling.*", "NonRetain_DB.pneum.*", "NonRetain_DB.diagn.*" ]
      },
      {
        "Name": "settings", "PeriodMs": 0, "Enabled": false,
        "Tags": [ "Settings_DB.meas.*", "Settings_DB.telemetry.*" ]
      }
    ]
  },

  "Telemetry": {
    "Enabled": true,
    "BindAddress": "0.0.0.0",
    "Port": 50100,
    "ExpectedLength": 512,
    "LayoutFile": "Config/telemetry.layout.json",
    "StaleAfterMs": 1000,
    "BroadcastPeriodMs": 100,
    "ConfigurePlcOnStartup": true,
    "ServerIp": "192.168.1.100",
    "PlcInterface": 2,
    "PeriodMs": 100
  },

  "Cors": { "Origins": [ "http://localhost:5173", "http://192.168.1.100:8080" ] }
}